'''         _myEvent.RemoveHandler(value)
'''     End RemoveHandler
'''     RaiseEvent(obj As Integer)
'''         _myEvent.RaiseEvent(obj)
'''     End RaiseEvent
''' End Event
''' </code>
''' </para>
