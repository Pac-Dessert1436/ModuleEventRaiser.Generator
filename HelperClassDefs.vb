    Private Sub RemoveDeadHandlersUnlocked()
        For i As Integer = _handlers.Count - 1 To 0 Step -1
            Dim target As TDelegate = Nothing
            If Not _handlers(i).TryGetHandler(target) Then
                _handlers.RemoveAt(i)
            End If
        Next i
